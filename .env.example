# ==========================================
# Autonomous MirAI Student Policy Advisor
# Root Environment Template
# ==========================================

# 1. Backend Settings (Stored in backend/.env)
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004
GOOGLE_CHAT_MODEL=gemini-3.8-flash
TEMPERATURE=0.0

HANDBOOK_PATH=./backend/data/Mirai_SoT_Policy_Handbook_2026.pdf
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

CHROMA_PERSIST_DIRECTORY=./backend/data/chroma_db
CHROMA_COLLECTION_NAME=mirai_policy_collection

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 2. Frontend Settings (Stored in frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
